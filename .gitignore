# Python bytecode and packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environment files
.env
.env.*

# Application logs
logs/*.log

# Generated reports. The directory itself stays in git.
data/reports/*
!data/reports/.gitkeep

# Editors
.idea/
.vscode/
*.swp

# Operating system files
Thumbs.db
Desktop.ini
